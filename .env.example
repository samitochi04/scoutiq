# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore.

# MongoDB Atlas
MONGODB_CLUSTER_USERNAME=your_username
MONGODB_CLUSTER_PASSWORD=your_password
MONGODB_CLUSTER_CONNECTION=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?appName=ScoutIQCluster

# Google Cloud
GCP_PROJECT_ID=scoutiq-498113
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json

# Arize Phoenix (observability — optional, for local tracing)
ARIZE_API_KEY=your_arize_api_key
ARIZE_SPACE_ID=your_arize_space_id

# football-data.org (free tier, fallback for live 2026 data)
FOOTBALL_DATA_API_KEY=your_football_data_api_key
