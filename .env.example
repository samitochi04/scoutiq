# Copy this file to .env and fill in your values.
# For Coolify deployment, set these as environment variables in the Coolify dashboard.
# NEVER commit .env to git — it's in .gitignore.

# ── MongoDB Atlas ─────────────────────────────────────────────
# Connection string format: mongodb+srv://user:pass@cluster.mongodb.net/?appName=AppName
MONGODB_CLUSTER_USERNAME=your_username
MONGODB_CLUSTER_PASSWORD=your_password
MONGODB_CLUSTER_CONNECTION=mongodb+srv://userName:pass@cluster.mongodb.net/?appName=projectName

# ── Google Cloud / Vertex AI ──────────────────────────────────
# GCP project where your Gemini agent and embeddings are deployed
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1

# GCP Service Account Credentials (choose ONE approach):
#
# LOCAL DEV: Use file path
#   GOOGLE_APPLICATION_CREDENTIALS=./aideplus-e945b9f5d625.json
#
# COOLIFY DEPLOYMENT: Use base64-encoded JSON (never commit this!)
#   1. Encode: base64 -w 0 < aideplus-e945b9f5d625.json
#   2. Set in Coolify dashboard: GCP_SERVICE_ACCOUNT_JSON=<base64_string>
#   3. The app will automatically decode and use it
#
GOOGLE_APPLICATION_CREDENTIALS=./aideplus-e945b9f5d625.json
# GCP_SERVICE_ACCOUNT_JSON=<base64_encoded_credentials_for_coolify>

# ── Arize Phoenix (observability — optional) ──────────────────
# Uncomment if using distributed tracing and monitoring
# ARIZE_API_KEY=your_arize_api_key
# ARIZE_SPACE_ID=your_arize_space_id

# ── External APIs (optional) ──────────────────────────────────
# football-data.org free tier for live 2026 World Cup data
FOOTBALL_DATA_API_KEY=your_football_data_api_key

# ── Server ────────────────────────────────────────────────────
# Set by Coolify or Docker; usually 8080 for Cloud Run / Container deployments
# PORT=8080
